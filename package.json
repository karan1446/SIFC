{
  "name": "vai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "seed": "npm --workspace=@vai/api run db:seed",
    "db:seed": "npm --workspace=@vai/api run db:seed",
    "dev:api": "npm --workspace=@vai/api run dev",
    "dev:web": "npm --workspace=@vai/web run dev",
    "dev": "node -e \"const { spawn } = require('child_process'); const cmd = process.platform === 'win32' ? 'npm.cmd' : 'npm'; spawn(cmd, ['--workspace=@vai/api', 'run', 'dev'], { stdio: 'inherit', shell: true }); spawn(cmd, ['--workspace=@vai/web', 'run', 'dev'], { stdio: 'inherit', shell: true });\"",
    "build:web": "npm --workspace=@vai/web run build",
    "api:walkthrough": "npm --workspace=@vai/api run api:walkthrough",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.18.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
